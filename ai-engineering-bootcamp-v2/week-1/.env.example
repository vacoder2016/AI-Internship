# OpenAI — chat + embeddings (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: override default embedding model (must match at ingest and query time)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone — https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Optional: logical partition inside the index (leave blank for default namespace)
PINECONE_NAMESPACE=

# Optional: chunking settings for POST /ingest
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=100

# Optional: chunks retrieved for POST /ask RAG (default 5)
RETRIEVE_TOP_K=5
